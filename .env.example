# Copy to .env locally. Never commit .env or real credentials.
ENVIRONMENT=development
LOG_LEVEL=INFO
LDAP_MOCK_MODE=true
REDIS_MOCK_MODE=true
AI_PROVIDER=fallback

# Generate a fresh value locally if using token-protected supervisor endpoints.
SUPERVISOR_API_KEY=

# Required only for the isolated Docker Compose directory/Redis simulation.
LDAP_BIND_PASSWORD=
LDAP_CONFIG_PASSWORD=
LDAP_READONLY_USER_PASSWORD=
REDIS_PASSWORD=

# Optional external model provider; leave blank for the default local demo.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
